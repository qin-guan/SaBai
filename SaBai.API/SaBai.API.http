@SaBai.API_HostAddress = http://localhost:5250

### Detect faces
POST {{SaBai.API_HostAddress}}/faces/detect
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="image"; filename="photo.jpg"
Content-Type: image/jpeg

< ./photo.jpg
--boundary--

### Enroll a face for a person
POST {{SaBai.API_HostAddress}}/persons/alice/faces
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="image"; filename="alice.jpg"
Content-Type: image/jpeg

< ./alice.jpg
--boundary--

### Identify everyone in a photo
POST {{SaBai.API_HostAddress}}/faces/identify?maxMatches=3
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="image"; filename="group.jpg"
Content-Type: image/jpeg

< ./group.jpg
--boundary--

### Verify two photos show the same person
POST {{SaBai.API_HostAddress}}/faces/verify
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="first"; filename="a.jpg"
Content-Type: image/jpeg

< ./a.jpg
--boundary
Content-Disposition: form-data; name="second"; filename="b.jpg"
Content-Type: image/jpeg

< ./b.jpg
--boundary--

### List a person's faces
GET {{SaBai.API_HostAddress}}/persons/alice/faces

### Delete a person
DELETE {{SaBai.API_HostAddress}}/persons/alice

### Orderable quantity per active ingredient (0 = out of stock; ordering it is refused)
GET {{SaBai.API_HostAddress}}/medication-stock/by-ingredient

### Place an order for an active ingredient (reserves stock, earliest expiry first; 409 if short)
POST {{SaBai.API_HostAddress}}/orders
Content-Type: application/json

{
  "consultId": "00000000-0000-0000-0000-000000000000",
  "medicationActiveIngredientId": "00000000-0000-0000-0000-000000000000",
  "quantity": 10,
  "dosageInstructions": "1 tablet twice daily",
  "remarks": "after food"
}

### Change a pending order (a new quantity or ingredient re-allocates the stock)
PATCH {{SaBai.API_HostAddress}}/orders/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "quantity": 14,
  "dosageInstructions": "1 tablet twice daily for 7 days"
}

### Dispense a pending order (CANCELLED releases its stock instead)
PATCH {{SaBai.API_HostAddress}}/orders/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "status": "DISPENSED"
}

### Pending orders with the batches to take them from
GET {{SaBai.API_HostAddress}}/pharmacy-orders

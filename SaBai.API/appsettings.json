{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "JwtSigningKey": "dev-only-signing-key-change-me-32b!",
    "Issuer": "sabai",
    "Audience": "sabai-api",
    "TokenLifetimeMinutes": 480
  },
  "WorkOS": {
    "ApiKey": "",
    "ClientId": "",
    "UseFake": false
  },
  "Storage": {
    "Bucket": "sabai",
    "Region": "us-east-1"
  },
  "FaceRecognition": {
    "DetectorModel": "det_10g.onnx",
    "RecognizerModel": "w600k_r50.onnx",
    "AutoDownloadModels": true,
    "DetectionSize": 640,
    "DetectionThreshold": 0.5,
    "MinimumFaceSize": 40,
    "MinimumEyeDistance": 12,
    "MatchThreshold": 0.4,
    "CollectionName": "faces"
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "SessionLifetimeMinutes": 480,
    "SecurityStampValidationMinutes": 1,
    "AuthenticatorIssuer": "Sa'Bai",
    "SeedDemoUsers": false,
    "BootstrapAdmin": {
      "UserName": "",
      "Password": "",
      "Email": null
    }
  },
  "Storage": {
    "Bucket": "sabai",
    "Region": "us-east-1"
  },
  "FaceRecognition": {
    "DetectorModel": "det_10g.onnx",
    "RecognizerModel": "w600k_r50.onnx",
    "AutoDownloadModels": true,
    "DetectionSize": 640,
    "DetectionThreshold": 0.5,
    "EnableDetectionFallback": true,
    "DetectionFallbackSize": 1024,
    "DetectionFallbackThreshold": 0.35,
    "MinimumFaceSize": 0,
    "MinimumEyeDistance": 0,
    "MatchThreshold": 0.4,
    "CollectionName": "faces"
  }
}

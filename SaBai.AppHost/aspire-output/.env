# Public browser URL for the API. Required at frontend image build time.
NEXT_PUBLIC_API_URL=

# Parameter postgres-password
POSTGRES_PASSWORD=

# Parameter qdrant-Key
QDRANT_KEY=

# Parameter rustFsAccessKey
RUSTFSACCESSKEY=

# Parameter rustFsSecretKey
RUSTFSSECRETKEY=

# Parameter workOsApiKey
WORKOSAPIKEY=

# Parameter workOsClientId
WORKOSCLIENTID=

